.row.top_row
  .col-sm-6.user_att
    %h2= @user.email
    %h4 Followers:
    - @user.followers.each do |follower|
      %p= follower.email
    - if @user.avatar_file_name
      = image_tag @user.avatar.url(:thumb)
  .col-sm-6
    = link_to 'Logout', log_out_path, class: ['btn', 'btn-danger', 'logout_btn']
  .row
    = link_to 'Add Photo', new_user_photo_path(@user), class: ['btn', 'btn-success', 'add_photo_btn']   
    = link_to 'All Users', users_path, class: ['btn', 'btn-info']
    - if @user.id == session[:user_id]
      = link_to 'Delete Account', user_path(@user), method: :delete, data: { confirm: 'Are you sure you want to delete your account?' }, class: ['btn', 'btn-danger']
