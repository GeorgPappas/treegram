.row
  - @photos.each  do |photo|
    .well.col-sm-4
      = image_tag photo.image.url(:medium)
      %p= photo.title
      - if photo.user_id == session[:user_id]
        = link_to 'Delete Photo', user_photo_path(photo.user, photo), method: :delete, data: { confirm: 'Are you sure?' }, class: ['btn', 'btn-danger', 'btn-xs']
      = form_for @tag do |f|
        = f.hidden_field :photo_id, value: photo.id
        = f.collection_select :user_id, @users, :id, :email
        = f.submit "Tag User"
      - photo.tags.each do |tag|
        = tag.user.email

      %hr/
      %h5 Comments:
      - photo.comments.each do |comment|
        %p
          %strong= "#{comment.user.email}:"
          = comment.body
          - if comment.user_id == session[:user_id] || photo.user_id == session[:user_id]
            = link_to 'Delete', comment_path(comment), method: :delete, class: ['btn', 'btn-danger', 'btn-xs']

      = form_for @comment do |f|
        = f.hidden_field :photo_id, value: photo.id
        = f.text_field :body, placeholder: "Write a comment...", class: 'form-control'
        = f.submit "Add Comment", class: ['btn', 'btn-primary', 'btn-sm']
